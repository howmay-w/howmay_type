# Discord Bot Token（必填）
# 在 Discord 開發者後台：你的應用程式 → Bot → Reset Token / Copy
DISCORD_BOT_TOKEN=your_bot_token_here

# 要監聽的頻道 ID（必填）
# 在 Discord 開啟「開發者模式」後，對頻道右鍵 → 複製頻道 ID
DISCORD_CHANNEL_ID=your_channel_id_here

# 應用程式 ID（選填，填了才會註冊 /新作品 Slash Command）
# 在開發者後台：你的應用程式 → General Information → Application ID
DISCORD_APPLICATION_ID=your_application_id_here

# 伺服器（Guild）ID（強烈建議填寫，指令會立即出現）
# 開發者模式開啟後，對「伺服器圖示」右鍵 → 複製伺服器 ID
# 不填則指令註冊為「全球」，可能需等約 1 小時才會在 Discord 顯示
DISCORD_GUILD_ID=your_guild_id_here

# GitHub Token（選填，填了會自動 commit + push）
# GitHub → Settings → Developer settings → Personal access tokens → 建立 token，權限勾選 repo
GITHUB_TOKEN=your_github_token_here

# 設為 true 時直接 push 到目前分支（如 main），不開新分支與 PR；不設或 false 則會開新分支並用 API 開 PR
# GITHUB_PUSH_DIRECT=true
