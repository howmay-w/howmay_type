---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "合作／委託 — 王皓梅 Howmay Wang";
---

<BaseLayout title={title}>
  <div class="content content--page contact hover-underline-animated">
    <h1 class="sr-only">合作／委託</h1>

    <section>
      <h2>工作信箱 / Email</h2>
      <p class="email-row">
        {/* Cloudflare 會把 email 改寫成 [email protected]，站內換頁時又不會解碼回來，所以這段請它略過 */}
        <Fragment set:html={"<!--email_off-->"} />
        <button type="button" class="copy-email" data-email="howmayw@gmail.com" aria-label="複製信箱 howmayw@gmail.com">
          howmayw@gmail.com
        </button>
        <Fragment set:html={"<!--/email_off-->"} />
        <span class="copy-feedback" aria-live="polite"></span>
      </p>
    </section>

    <section>
      <h2>來訊 / Message me</h2>
      <ul>
        <li>
          <a href="https://signal.me/#eu/hJR_X4vl-r0z_GurXwdAsBHqkOs_FMNSJyJ_0widnMfwhj5QA89KfLk_cMDzQElz" target="_blank" rel="noopener noreferrer">
            Signal ↗
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/howmay__/" target="_blank" rel="noopener noreferrer">
            Instagram ↗
          </a>
        </li>
      </ul>
    </section>

    <section>
      <h2>演講・工作坊 / Talks & Workshops</h2>
      <p>
        相關邀講請至
        <a href="https://blog.justfont.com/projects/invite/" target="_blank" rel="noopener noreferrer">
          justfont 講座邀請 ↗
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // 複製信箱：先用 Clipboard API；不能用時（非 HTTPS、LINE／IG 等 App 內建瀏覽器常會擋）
  // 改用舊的 execCommand 複製；都失敗就把信箱文字選起來，讓使用者長按複製
  const legacyCopy = (text: string) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    // 字級 16px 避免 iOS 聚焦時放大畫面；放在畫面外
    ta.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0;font-size:16px;';
    document.body.appendChild(ta);
    ta.select();
    ta.setSelectionRange(0, text.length);
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    ta.remove();
    return ok;
  };
  const selectText = (el: Element) => {
    const range = document.createRange();
    range.selectNodeContents(el);
    const sel = window.getSelection();
    sel?.removeAllRanges();
    sel?.addRange(range);
  };
  const copyText = async (text: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // 被擋（權限、App 內建瀏覽器）時往下用舊方法
      }
    }
    return legacyCopy(text);
  };

  // 站內換頁（ClientRouter）時這段只會執行一次，所以每次進到委託頁都要重新綁定
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.copy-email').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email') ?? '';
        const feedback = btn.parentElement?.querySelector('.copy-feedback');
        const ok = await copyText(email);
        if (!feedback) return;
        feedback.classList.remove('fade-out');
        if (ok) {
          feedback.textContent = '已複製';
          setTimeout(() => {
            feedback.classList.add('fade-out');
            setTimeout(() => {
              feedback.textContent = '';
              feedback.classList.remove('fade-out');
            }, 300);
          }, 1500);
        } else {
          selectText(btn);
          feedback.textContent = '已選取，請長按複製';
        }
      });
    });
  });
</script>

<style>
  h2 {
    font-size: 0.85rem;
    /* Zen Kaku 沒有 600，原本的 600 一律改 700（中文本來就顯示 700，英文跟著一致） */
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faded);
    margin: 0 0 0.75rem;
  }
  @media (max-width: 640px) {
    h2 {
      font-size: 0.75rem;
    }
  }
  /* 內文與專案頁 .prose 一致：字型、行高、字距、段落間距 */
  .contact p,
  .contact ul li {
    font-family: "TASA Explorer Variable", system-ui, "GenKiGothicTW", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  .contact p {
    margin: 0.5rem 0;
  }
  p {
    margin: 0;
  }
  .contact ul {
    padding-left: 0rem;
  }
  .copy-email {
    background: none;
    border: none;
    padding: 0;
    /* 複製失敗時會把信箱選起來讓人長按複製，按鈕預設不能選字，這裡打開 */
    -webkit-user-select: text;
    user-select: text;
    font: inherit;
    color: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .email-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }
  .copy-feedback {
    margin-left: 0.25rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-alt);
    opacity: 1;
    transition: opacity 0.3s ease;
  }
  .copy-feedback.fade-out {
    opacity: 0;
  }
  a {
    color: inherit;
    font-weight: 700;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .contact ul li {
    line-height: 1.45;
  }
  li {
    font-weight: 400;
    line-height: 1.7;
  }
  @media (max-width: 640px) {
    /* 提高優先級以覆蓋 global .content--page 的 max-width: 32rem */
    :global(.content--page).contact {
      max-width: 22rem;
    }
    .contact p,
    .contact ul li {
      font-size: 0.9rem;
    }
  }
</style>
