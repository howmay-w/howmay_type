---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About — 皓梅 Howmay";
const description = "皓梅 Howmay，台灣漢字美術字與標準字設計師。目前於 justfont 從事字體設計與推廣，作品以 Lettering 與 Logotype 創作為主。";
---

<BaseLayout title={title} description={description}>
  <div class="content content--page about hover-underline-animated">
    <section>
      <h1>皓梅 Howmay</h1>
      <p>
        來自台灣，在這裡放美術字與標準字設計／創作，以台灣語言、漢字為主。
        大多作品以 <a href="https://procreate.com/" target="_blank" rel="noopener noreferrer">Procreate</a> 完成，有時也會進 <a href="https://glyphsapp.com/" target="_blank" rel="noopener noreferrer">Glyphs</a> 或<a href="https://www.adobe.com/tw/products/illustrator.html" target="_blank" rel="noopener noreferrer">以拉</a>完稿。
      </p>
      <p>
      目前在 <a href="https://justfont.com/" target="_blank" rel="noopener noreferrer">justfont</a> 做設計、字體行銷與教育推廣等，自己滿喜歡的專案有
        <a href="https://justfont.com/jf7000" target="_blank" rel="noopener noreferrer">jf 7000 字集</a>、<a href="https://justfont.com/kamabit/" target="_blank" rel="noopener noreferrer">柑仔蜜</a>、<a href="https://blog.justfont.com/2024/10/elffont/" target="_blank" rel="noopener noreferrer">精靈文</a>等。也喜歡到處去演講、帶字型散步。
      </p>
      <p>
        平常喜歡拍字，下班後會畫畫字作為日記與練習。之前作品只放在 
        <a href="https://www.instagram.com/howmay__/" target="_blank" rel="noopener noreferrer">@howmay__</a>
        ，最近總算製作了網頁，未來也會在此更新。
      </p>
    </section>

    <section class="related-links">
      <h2>歡迎看看 / See also </h2>
      <ul>
        <li>
          鼓勵我自己弄個網站的男友
          <a href="https://kiantiong.com" target="_blank" rel="noopener noreferrer">建中 ↗</a>
        </li>
        <li>
          上班的地方，很認真的台灣字體公司
          <a href="https://justfont.com/" target="_blank" rel="noopener noreferrer">justfont ↗</a>
          
        </li>
      </ul>
    </section>

    <section class="credits">
      <h2>致謝 / Credits</h2>
      <ul>
        <li>
          Based on UI by <a href="https://alextkachev.com/" target="_blank" rel="noopener noreferrer">Alex Tkachev</a>
        </li>
        <li>
          Template <a href="https://tympanus.net/codrops/?p=86632" target="_blank" rel="noopener noreferrer">Players Club</a>
          by <a href="https://www.codrops.com" target="_blank" rel="noopener noreferrer">Codrops</a>
        </li>
        <li>
          Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 2.8rem);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faded);
    margin: 0 0 0.75rem;
  }
  @media (max-width: 640px) {
    h2 {
      font-size: 0.75rem;
    }
  }
  /* 內文與專案頁 .prose 一致：字型、行高、字距、段落間距 */
  .about p,
  .about .related-links li,
  .about .credits li {
    font-family: "TASA Explorer Variable", system-ui, "GenKiGothicTW", sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  .about p {
    margin: 0.5rem 0;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
    font-weight: 600;
  }
  .related-links ul,
  .credits ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .related-links li,
  .credits li {
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-text);
  }
  @media (max-width: 640px) {
    /* 手機時縮窄；一般寬度維持 32rem */
    :global(.content--page).about {
      max-width: 21rem;
    }
    .about p,
    .about .related-links li,
    .about .credits li {
      font-size: 0.9rem;
    }
  }
</style>
