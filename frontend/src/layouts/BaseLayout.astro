---
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";

import { SEO } from "astro-seo";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SmoothScroll from "../components/SmoothScroll.astro";

import "@fontsource-variable/tasa-explorer";
import "@fontsource/zen-kaku-gothic-new/300.css";
import "@fontsource/zen-kaku-gothic-new/400.css";
import "@fontsource/zen-kaku-gothic-new/500.css";
import "@fontsource/zen-kaku-gothic-new/700.css";
import tasaExplorerWoff2 from "@fontsource-variable/tasa-explorer/files/tasa-explorer-latin-wght-normal.woff2";

type Props = {
	title: string;
	description?: string;
	/** 社群分享預覽圖：以 / 開頭的站內路徑或完整 https URL；未指定時用預設網站圖示 */
	ogImage?: string;
	ogImageAlt?: string;
};

const { title, description = "皓梅的畫字創作頻道", ogImage, ogImageAlt } = Astro.props;

const defaultOgPath = "/favicon/apple-touch-icon.png";
const rawOgImage = ogImage ?? defaultOgPath;
const ogImageUrl = /^https?:\/\//i.test(rawOgImage)
	? rawOgImage
	: new URL(rawOgImage.startsWith("/") ? rawOgImage : `/${rawOgImage}`, Astro.site ?? Astro.url).href;
const resolvedOgAlt = ogImageAlt ?? (ogImage ? title : description);

// Current page value (/home, /about, /404 ...)
const currentPage =
	Astro.url.pathname.replace(/\/$/, "").split("/").pop() || "home";
---

<!doctype html>
<html lang="en" data-page={currentPage}>
  <head>
    <SEO
      title={title}
      description={description}
      charset="UTF-8"
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: ogImageUrl,
        },
        optional: {
          description: description,
        },
        image: {
          alt: resolvedOgAlt,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: ogImageUrl,
        imageAlt: resolvedOgAlt,
      }}
      extend={{
        // extending the default link tags
        link: [
          {
            rel: "stylesheet",
            href: "https://font.emtech.cc/css/GenKiGothicTW",
          },
          {
            rel: "icon",
            type: "image/png",
            sizes: "16x16",
            href: "/favicon/favicon-16x16.png",
          },
          {
            rel: "icon",
            type: "image/png",
            sizes: "32x32",
            href: "/favicon/favicon-32x32.png",
          },
          {
            rel: "apple-touch-icon",
            sizes: "180x180",
            href: "/favicon/apple-touch-icon.png",
          },
          { rel: "manifest", href: "/favicon/site.webmanifest" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
          {
            rel: "preload",
            href: tasaExplorerWoff2,
            as: "font",
            type: "font/woff2",
            crossorigin: "anonymous",
          },
        ],
        // extending the default meta tags
        meta: [
          { name: "viewport", content: "width=device-width, initial-scale=1, maximum-scale=1" },
          { name: "msapplication-TileColor", content: "#000000" },
          { name: "theme-color", content: "#ffffff" },
          { name: "generator", content: Astro.generator },
        ],
      }}
    />
    <ClientRouter />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-79ZRJH1JBN"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-79ZRJH1JBN');
</script>
</head>
  <body>
    <SmoothScroll />
    <Header />
    <slot />
    <Footer />
    <script src="../scripts/imageFade.js"></script>
  </body>
</html>
