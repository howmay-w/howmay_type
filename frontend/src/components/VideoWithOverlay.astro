---
type Props = {
	src: string;
	poster?: string;
	class?: string;
};

const { src, poster, class: className = "" } = Astro.props;
---

<div class={`video-with-overlay ${className}`.trim()} data-video-with-overlay>
	<video
		class="video-with-overlay__video"
		src={src}
		poster={poster}
		playsinline
		preload="metadata"
		muted
		tabindex="-1"
	>
		<track kind="captions" />
	</video>
	<div class="video-with-overlay__overlay" data-video-overlay>
		<button type="button" class="video-with-overlay__play-btn" aria-label="播放／暫停">
			<span class="video-with-overlay__icon video-with-overlay__icon--play" aria-hidden="true">
				<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M8 5v14l11-7z" />
				</svg>
			</span>
			<span class="video-with-overlay__icon video-with-overlay__icon--pause" aria-hidden="true">
				<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
				</svg>
			</span>
		</button>
		<div class="video-with-overlay__progress">
			<div class="video-with-overlay__progress-fill"></div>
		</div>
	</div>
</div>

<style>
	.video-with-overlay {
		position: relative;
		width: 100%;
		background: #0c0c0c;
	}
	.video-with-overlay__video {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		vertical-align: middle;
	}
	/* iOS 在影片播完時會蓋上系統的重播圓箭頭，改由下面的播放鈕接手 */
	.video-with-overlay__video::-webkit-media-controls-overlay-play-button,
	.video-with-overlay__video::-webkit-media-controls-start-playback-button {
		display: none !important;
		-webkit-appearance: none;
	}
	.video-with-overlay__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.25s ease;
		cursor: pointer;
	}
	/* 觸控裝置點一下後 :hover 會一直留著，按鈕不會消失；hover 只給滑鼠用，觸控時由 script 加 data-show */
	@media (hover: hover) {
		.video-with-overlay:hover .video-with-overlay__overlay {
			opacity: 1;
		}
	}
	.video-with-overlay__overlay[data-show] {
		opacity: 1;
	}
	.video-with-overlay__play-btn {
		width: 3.5rem;
		height: 3.5rem;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s;
	}
	.video-with-overlay__play-btn:hover {
		background: rgba(0, 0, 0, 0.6);
	}
	.video-with-overlay__play-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
	.video-with-overlay__icon {
		display: none;
		width: 2rem;
		height: 2rem;
	}
	.video-with-overlay__icon svg {
		width: 100%;
		height: 100%;
	}
	.video-with-overlay__play-btn[data-playing="false"] .video-with-overlay__icon--play,
	.video-with-overlay__play-btn[data-playing="true"] .video-with-overlay__icon--pause {
		display: block;
	}
	.video-with-overlay__progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		background: rgba(255, 255, 255, 0.25);
		pointer-events: none;
	}
	.video-with-overlay__progress-fill {
		height: 100%;
		width: 0%;
		background: rgba(255, 255, 255, 0.9);
		transition: width 0.1s linear;
	}
</style>

<script>
	// 和輪播相同：隨機是整頁載入；首頁、上一篇、下一篇在動畫結束前 html 帶著 data-astro-transition。
	// 這段時間裡的影片會被瀏覽器凍結。
	function whenSettled(fn: (afterTransition: boolean) => void) {
		const root = document.documentElement;
		if (!root.hasAttribute("data-astro-transition")) {
			fn(false);
			return;
		}
		let settled = false;
		const finish = () => {
			if (settled) return;
			settled = true;
			obs.disconnect();
			clearTimeout(backup);
			fn(true);
		};
		const obs = new MutationObserver(() => {
			if (!root.hasAttribute("data-astro-transition")) finish();
		});
		obs.observe(root, { attributes: true, attributeFilter: ["data-astro-transition"] });
		const backup = setTimeout(finish, 1200);
	}

	function initVideoWithOverlay(container: HTMLElement) {
		if ((container as HTMLElement & { _videoOverlayInited?: boolean })._videoOverlayInited) return;
		(container as HTMLElement & { _videoOverlayInited?: boolean })._videoOverlayInited = true;

		const video = container.querySelector("video");
		const overlay = container.querySelector("[data-video-overlay]") as HTMLElement | null;
		if (!video || !overlay) return;
		const playBtn = overlay.querySelector(".video-with-overlay__play-btn") as HTMLButtonElement | null;
		const progressFill = overlay.querySelector(".video-with-overlay__progress-fill") as HTMLElement | null;
		let playGen = 0;
		let userPaused = false;

		function updateUI() {
			const playing = !video.paused;
			if (playBtn) {
				playBtn.setAttribute("data-playing", String(playing));
				playBtn.setAttribute("aria-label", playing ? "暫停" : "播放");
			}
			if (progressFill && Number.isFinite(video.duration) && video.duration > 0) {
				progressFill.style.width = `${(video.currentTime / video.duration) * 100}%`;
			}
		}

		function playVideo(attempt = 0) {
			const gen = playGen;
			video.muted = true;
			video.play().catch((err: DOMException) => {
				if (gen !== playGen || userPaused) return;
				if ((err.name === "AbortError" || err.name === "NotAllowedError") && attempt < 8) {
					setTimeout(() => {
						if (gen !== playGen || userPaused || !video.paused) return;
						playVideo(attempt + 1);
					}, 250);
					return;
				}
				overlay.setAttribute("data-show", "");
			});
		}

		// 先回到開頭再播。同一個回合裡又 seek 又 play()，會立刻被送到片尾停住
		function playFromStart() {
			const gen = ++playGen;
			const begin = () => {
				if (gen !== playGen || userPaused) return;
				const go = () => {
					if (gen !== playGen || userPaused) return;
					playVideo();
				};
				if (video.currentTime < 0.05 && !video.seeking && !video.ended) {
					go();
					return;
				}
				const onSeeked = () => {
					video.removeEventListener("seeked", onSeeked);
					go();
				};
				video.addEventListener("seeked", onSeeked);
				try {
					video.currentTime = 0;
				} catch {
					video.removeEventListener("seeked", onSeeked);
					if (video.readyState === 0) video.addEventListener("loadedmetadata", begin, { once: true });
					else go();
					return;
				}
				if (!video.seeking && video.currentTime < 0.05) {
					video.removeEventListener("seeked", onSeeked);
					go();
				}
			};
			if (video.readyState >= 1) begin();
			else video.addEventListener("loadedmetadata", begin, { once: true });
		}

		function togglePlay() {
			if (video.paused) {
				userPaused = false;
				if (video.ended || (Number.isFinite(video.duration) && video.currentTime >= video.duration - 0.15)) playFromStart();
				else playVideo();
			} else {
				userPaused = true;
				playGen++;
				video.pause();
			}
		}

		// 觸控時點按後短暫顯示按鈕；播放中 1.5 秒後收起，暫停時留著
		let hideTimer: ReturnType<typeof setTimeout> | null = null;
		function flash() {
			overlay.setAttribute("data-show", "");
			if (hideTimer !== null) clearTimeout(hideTimer);
			hideTimer = setTimeout(() => {
				hideTimer = null;
				if (!video.paused) overlay.removeAttribute("data-show");
			}, 1500);
		}
		// 還沒播放、或播完時，觸控裝置上也要看得到播放鈕
		if (window.matchMedia("(hover: none)").matches) overlay.setAttribute("data-show", "");
		video.addEventListener("ended", () => {
			overlay.setAttribute("data-show", "");
			// 離開 ended，iOS 才不會顯示系統的重播圖示；停在片尾，按鈕維持播放
			const hold = Math.max(0, (video.duration || 0) - 0.05);
			if (hold > 0) video.currentTime = hold;
			updateUI();
		});
		video.addEventListener("play", () => {
			if (hideTimer === null) overlay.removeAttribute("data-show");
		});

		video.addEventListener("play", updateUI);
		video.addEventListener("pause", updateUI);
		video.addEventListener("timeupdate", updateUI);
		video.addEventListener("loadedmetadata", updateUI);
		updateUI();

		overlay.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			togglePlay();
			flash();
		});
		// 點影片本體也可播放（overlay 透明時仍可點到）
		video.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			togglePlay();
			flash();
		});

		// 進頁就播。換頁動畫結束後要先 load()，否則這支影片會停在封面上
		whenSettled((afterTransition) => {
			if (userPaused) return;
			if (afterTransition) video.load();
			playFromStart();
		});
	}

	function initAll() {
		document.querySelectorAll<HTMLElement>("[data-video-with-overlay]").forEach(initVideoWithOverlay);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAll);
	} else {
		initAll();
	}
	document.addEventListener("astro:page-load", initAll);
</script>
