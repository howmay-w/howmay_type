---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectTooltip from "./ProjectTooltip.astro";

const INITIAL_BATCH = 24;

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;
const grid = "projects";
---

<section class="project-grid" id="grid" data-grid={grid}>
	{projects.map((project, i) => (
		<ProjectCard project={project} deferred={i >= INITIAL_BATCH} />
	))}
</section>

<div id="search-no-results-wrap" class="search-no-results-wrap content content--page content--page--center hidden" aria-live="polite">
	<h1>߹ᯅ߹</h1>
	<p>沒找到⋯⋯請試試其他關鍵字</p>
</div>
<div id="load-more-wrap" class="load-more-wrap">
	<button
		id="load-more"
		class={projects.length <= INITIAL_BATCH ? "hidden" : ""}
		aria-label="Load more"
	>
		MORE
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
	</button>
</div>

<ProjectTooltip />

<script src="../scripts/hoverVideo.js"></script>

<style>
	.project-grid {
		position: relative;
		overflow: hidden;
		display: grid;
		width: 100%;
		grid-template-columns: repeat(2, 1fr);
		grid-auto-rows: calc((100vw - 2rem) / 2);
		align-items: stretch;
		margin: 1rem 0 0;
		min-height: 400px;
		gap: 0;
		line-height: 0;
	}
	.project-grid.grid--no-results {
		min-height: 0;
		margin: 0;
	}
	/* 隱藏尚未載入批次的卡片（用 :global 確保套用到子元件的 <a> 元素） */
	:global(.project-grid a[data-deferred]) {
		display: none;
	}
	@media screen and (min-width: 30em) {
		.project-grid {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: calc((100vw - 2rem) / 4);
		}
	}
	@media screen and (min-width: 50em) {
		.project-grid {
			grid-template-columns: repeat(6, 1fr);
			grid-auto-rows: calc((100vw - 2rem) / 6);
		}
	}
	.load-more-wrap {
		display: flex;
		justify-content: center;
		padding: 3rem 0 4rem;
	}
	#load-more {
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		background: none;
		border: none;
		padding: 0;
		color: inherit;
		transition: color 0.3s;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
	}
	#load-more:hover {
		color: var(--color-link-hover);
	}
	#load-more.hidden {
		display: none;
	}
	.load-more-wrap.hidden {
		display: none;
	}
	.search-no-results-wrap {
		min-height: calc(100vh - 18.2rem);
	}
	.search-no-results-wrap.hidden {
		display: none !important;
	}
</style>
