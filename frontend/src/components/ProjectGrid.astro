---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectTooltip from "./ProjectTooltip.astro";

const INITIAL_BATCH = 24;

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;
const grid = "projects";
---

<section class="project-grid" id="grid" data-grid={grid}>
	{projects.map((project, i) => (
		<ProjectCard project={project} deferred={i >= INITIAL_BATCH} />
	))}
</section>

<div id="search-no-results-wrap" class="search-no-results-wrap content content--page content--page--center hidden" aria-live="polite">
	<h1>߹ᯅ߹</h1>
	<p>沒找到⋯⋯請試試其他關鍵字</p>
</div>
<div id="load-more-wrap" class="load-more-wrap">
	<button
		id="load-more"
		class={projects.length <= INITIAL_BATCH ? "hidden" : ""}
		aria-label="Load more"
	>
		MORE
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
	</button>
</div>

<ProjectTooltip />

<script src="../scripts/hoverVideo.js"></script>

<style>
	.project-grid {
		position: relative;
		overflow: hidden;
		display: grid;
		width: 100%;
		grid-template-columns: repeat(2, 1fr);
		grid-auto-rows: calc((100vw - 2rem) / 2);
		align-items: stretch;
		margin: 1rem 0 0;
		min-height: 400px;
		gap: 0;
		line-height: 0;
	}
	.project-grid.grid--no-results {
		min-height: 0;
		margin: 0;
	}
	/* 隱藏尚未載入批次的卡片（用 :global 確保套用到子元件的 <a> 元素） */
	:global(.project-grid a[data-deferred]) {
		display: none;
	}
	@media screen and (min-width: 30em) {
		.project-grid {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: calc((100vw - 2rem) / 4);
		}
	}
	@media screen and (min-width: 50em) {
		.project-grid {
			grid-template-columns: repeat(6, 1fr);
			grid-auto-rows: calc((100vw - 2rem) / 6);
		}
	}
	.load-more-wrap {
		display: flex;
		justify-content: center;
		padding: 3rem 0 4rem;
	}
	#load-more {
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		background: none;
		border: none;
		padding: 0;
		color: inherit;
		transition: color 0.3s;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
	}
	#load-more:hover {
		color: var(--color-link-hover);
	}
	#load-more.hidden {
		display: none;
	}
	.load-more-wrap.hidden {
		display: none;
	}
	.search-no-results-wrap {
		min-height: calc(100vh - 12rem);
	}
	@media screen and (min-width: 50em) {
		.search-no-results-wrap {
			padding: 1rem 1rem 1.25rem 1rem;
		}
	}
	.search-no-results-wrap.hidden {
		display: none !important;
	}

	/* ── 字牆模式（html[data-view="type"]，由 gridViewMode.js 切換）── */
	:global(html[data-view="type"]) {
		--color-text: #eee;
		--color-text-alt: #8a8a8a;
		--color-bg: #111;
		--border-color: #333;
		--color-link: #eee;
		--color-link-hover: #777;
		--color-placeholder: transparent;
		--wm-color: #f2f2f2;
		background: var(--color-bg);
		transition: background-color 0.4s;
	}
	:global(html[data-view="type"]) .project-grid {
		/* 位置與尺寸由 gridViewMode.js 寫入百分比 --x / --y / --w，整面牆用長寬比隨寬度等比例縮放 */
		display: block;
		height: auto;
		aspect-ratio: var(--wall-ratio, auto);
		margin-top: clamp(2rem, 5vw, 4rem);
		margin-bottom: 1rem;
		overflow: visible;
	}
	/* 沒有字圖（或標成 hidden）的作品不出現在字牆；!important 是為了蓋過搜尋時寫入的 inline display */
	:global(html[data-view="type"] .project-grid > a:not([data-wordmark])) {
		display: none !important;
	}
	:global(html[data-view="type"] .project-grid > a[data-wordmark]) {
		position: absolute;
		left: var(--x, 0);
		top: var(--y, 0);
		width: var(--w, 120px);
		height: auto;
		aspect-ratio: var(--a);
		overflow: visible;
		background: none;
	}
	/* 視窗寬度跨過分段、重新排版時，讓字滑到新位置而不是瞬間跳動 */
	:global(html[data-view="type"] .project-grid.wall--glide > a[data-wordmark]) {
		transition:
			left 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	:global(html[data-view="type"] .project-grid .project-card__img-wrap) {
		display: none;
	}
	:global(html[data-view="type"] .project-grid .project-card__wordmark) {
		position: absolute;
		inset: 0;
		display: block;
		background-color: var(--wm-color);
		-webkit-mask: var(--wm) center / contain no-repeat;
		mask: var(--wm) center / contain no-repeat;
		transition: background-color 0.35s;
	}
	/* hover 時字變回原作的顏色；太暗的顏色在卡片端已換成網站強調色 */
	@media (hover: hover) {
		:global(html[data-view="type"] .project-grid > a:hover .project-card__wordmark) {
			background-color: var(--accent, var(--color-link-underline));
		}
	}
	/* 黑底上黑色提示框看不出來，改成淺色 */
	:global(html[data-view="type"] .tooltip) {
		background: #f2f2f2 !important;
		box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.5);
	}
	:global(html[data-view="type"] .tooltip .oh__inner),
	:global(html[data-view="type"] .tooltip .tooltip__year) {
		color: #111 !important;
	}
	:global(html[data-view="type"] .tooltip .tooltip__row--muted .oh__inner) {
		color: #666 !important;
	}
	:global(html[data-view="type"] .project-grid > a:focus-visible) {
		outline: 1px solid var(--wm-color);
		outline-offset: 0.5rem;
	}
</style>
