---
import Cross from "../assets/images/cross.svg";
---

<div id="search-overlay" aria-hidden="true"></div>
<dialog id="search-dialog">
  <form method="dialog">
    <label for="search-input" class="sr-only">Search:</label>
    <input
      aria-label="search"
      type="text"
      id="search-input"
      placeholder="搜尋文字或標籤"
      maxlength="10"
    />
    <span></span>
    <button id="close-dialog" type="button" aria-label="Close search"
      ><Cross width={9} height={9} /></button
    >
  </form>
</dialog>

<style>
  /* 使用 backdrop-filter 覆蓋層取代 body blur，避免 Safari 在 blur + transform 動畫時產生線條殘影 */
  #search-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    background: rgba(255, 255, 255, 0.02);
    pointer-events: auto;
  }
  #search-overlay[data-visible] {
    display: block;
  }
  dialog {
    filter: none; /* Ensure the dialog itself is not blurred */
    pointer-events: auto; /* Allow interaction with the dialog */
    border: 0;
    padding: 2rem;
    width: clamp(200px, 36vw, 340px);
    background: var(--color-text);
    color: var(--color-bg);
  }
  button {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
  input {
    background: none;
    width: 100%;
    font-size: var(--font-size-l);
    font-family: "TASA Explorer Variable", "Zen Kaku Gothic New", "GenKiGothicTW", sans-serif;
    border: 0;
    color: inherit;
    font-weight: 500;
    padding: 0 0 0.5rem 0;
    border-bottom: 1px solid var(--color-faded);
  }
  input:focus {
    outline: none;
  }

  input::placeholder {
    font-family: "Zen Kaku Gothic New", "GenKiGothicTW", sans-serif;
    font-weight: 500;
    font-size: 0.9em;
    color: var(--color-faded);
    opacity: 0.4;
  }

  span {
    font-size: var(--font-size-s);
    color: var(--color-faded);
    margin-top: 0.5rem;
    display: block;
  }
</style>
