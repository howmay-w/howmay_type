---
import { createHash } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { hoverColor } from "../utils/hoverColor";
import { getWebpSize } from "../utils/webpSize";

function getProjectSlug(id: string) {
	return id.replace(/\/index$/, "") || id;
}

// 標題推算字數：漢字算 1，英數字母算 0.5，標點與符號不算
function countChars(title: string) {
	const han = title.match(/[\p{Script=Han}\p{Script=Bopomofo}\p{Script=Hiragana}\p{Script=Katakana}]/gu)?.length ?? 0;
	const latin = title.match(/[A-Za-z0-9]/g)?.length ?? 0;
	return Math.max(1, han + latin * 0.5);
}

// 字牆：讓每件作品的「單字量感」一致。面積 ∝ 字數，再用墨量微調（筆畫細的放大、粗的縮小）
const INK_REF = 0.3;
type WordmarkData = NonNullable<CollectionEntry<"projects">["data"]["wordmark"]>;
function getWordmark(slug: string, title: string, wordmark: WordmarkData | undefined) {
	if (!wordmark || wordmark.hidden) return null;
	const file = path.join(process.cwd(), "src/content/projects", slug, path.basename(wordmark.src));
	const size = getWebpSize(file);
	if (!size) return null;
	const aspect = size.width / size.height;
	const chars = wordmark.chars ?? countChars(title);
	const ink = Math.min(0.8, Math.max(0.08, wordmark.ink ?? INK_REF));
	const sizeMul = { s: 0.8, m: 1, l: 1.3 }[wordmark.size ?? "m"];
	// mass = 以「一個字的面積」為單位的作品面積，前端排版時乘上基準單位
	const mass = chars * (INK_REF / ink) ** 0.2 * sizeMul ** 2;
	// hover 用原作字色；太暗的保留色相提亮，沒有顏色的（黑、灰）才用網站的強調色
	const accent = hoverColor(wordmark.accent);
	// 手動倍率最後才乘在寬度上（見 gridViewMode.js），×2 就是兩倍寬，不受單字面積下限影響
	const scale = wordmark.scale ?? 1;
	// 換圖時檔名不變，用內容雜湊當版本號，瀏覽器才不會一直顯示快取裡的舊字圖
	const version = createHash("md5").update(new Uint8Array(fs.readFileSync(file))).digest("hex").slice(0, 8);
	return { src: `${wordmark.src}?v=${version}`, aspect: aspect.toFixed(4), mass: mass.toFixed(3), scale: String(scale), accent };
}

type Props = {
	project: CollectionEntry<"projects">;
	deferred?: boolean;
};

const { project, deferred = false } = Astro.props;
const slug = getProjectSlug(project.id);
const { title, thumbnail, image, images, hoverVideo, hoverVideoFit, video, pubDate, tags, wordmark, extraWordmarks } = project.data;
// 主字圖隱藏時，第一個可顯示的其他款接替成為卡片本身；其餘每款在字牆上各自是一塊（見下方的 data-wm-extra）
const [wm, ...extras] = [wordmark, ...(extraWordmarks ?? [])]
	.map((w) => getWordmark(slug, title, w))
	.filter((w) => w !== null);
// 縮圖優先順序：專屬縮圖 thumbnail → 輪播第一張 images[0] → 單張 image
const heroImage = thumbnail ?? (images?.length ? images[0] : image);
// 若完全沒有圖片但有影片，用影片第一格當封面
const thumbVideoSrc = !heroImage && video?.src ? video.src : null;
const year = pubDate ? new Date(pubDate).getFullYear().toString() : "";
const dateStr = pubDate ? new Date(pubDate).toISOString().slice(0, 10) : "";
const tagsStr = tags?.length ? tags.join("、") : "";
---

<a
	class="project-card"
	data-project-title={title}
	data-project-year={year}
	data-project-date={dateStr}
	data-project-tags={tagsStr}
	data-hover-video={hoverVideo?.src ?? ""}
	data-hover-video-fit={hoverVideoFit ?? ""}
	data-astro-prefetch="tap"
	{...(deferred ? { "data-deferred": "" } : {})}
	{...(wm ? { "data-wordmark": "", "data-wm-aspect": wm.aspect, "data-wm-mass": wm.mass, "data-wm-scale": wm.scale } : {})}
	style={wm ? `--wm:url("${wm.src}");--a:${wm.aspect}${wm.accent ? `;--accent:${wm.accent}` : ""}` : undefined}
	href={`/projects/${slug}`}
>
	<article>
		{heroImage && (
			<span class="project-card__img-wrap">
				<picture>
					<img
						src={heroImage.src}
						alt={heroImage.alt ?? title}
						width="800"
						loading={deferred ? "lazy" : "eager"}
						decoding="async"
					/>
				</picture>
			</span>
		)}
		{!heroImage && thumbVideoSrc && (
			<span class="project-card__img-wrap">
				<video
					class="project-card__thumb-video"
					src={thumbVideoSrc}
					data-thumb-video={thumbVideoSrc}
					muted
					playsinline
					preload="metadata"
					aria-hidden="true"
				></video>
			</span>
		)}
		{wm && <span class="project-card__wordmark" aria-hidden="true"></span>}
		<span class="sr-only">
			<h3>{title}</h3>
			{pubDate && <p>{new Date(pubDate).getFullYear()}</p>}
		</span>
	</article>
</a>
{extras.map((x, i) => (
	<a
		class="project-card project-card--extra"
		data-wm-extra={`/projects/${slug}`}
		data-wm-index={i + 1}
		data-project-title={title}
		data-project-year={year}
		data-project-date={dateStr}
		data-project-tags={tagsStr}
		data-wordmark=""
		data-wm-aspect={x.aspect}
		data-wm-mass={x.mass}
		data-wm-scale={x.scale}
		style={`--wm:url("${x.src}");--a:${x.aspect}${(x.accent ?? wm?.accent) ? `;--accent:${x.accent ?? wm?.accent}` : ""}`}
		href={`/projects/${slug}`}
		tabindex="-1"
		aria-hidden="true"
	>
		<span class="project-card__wordmark"></span>
	</a>
))}

<style>
	.project-card {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: var(--color-placeholder, #eee);
		line-height: 0;
		-webkit-touch-callout: none;
		user-select: none;
	}
	.project-card article {
		position: absolute;
		inset: 0;
		display: block;
	}
	.project-card__img-wrap {
		position: absolute;
		inset: 0;
		display: block;
	}
	.project-card__img-wrap picture,
	.project-card__img-wrap img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}
	.project-card__thumb-video {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		min-width: 100%;
		min-height: 100%;
		width: auto;
		height: auto;
		display: block;
	}
	.project-card__wordmark {
		display: none;
	}
	/* 其他款字圖只出現在字牆；圖片模式與排序、搜尋都不把它當成一張卡片（見 productGridActions.js） */
	.project-card--extra {
		display: none;
	}
	h3,
	p {
		margin: 0;
	}
</style>
