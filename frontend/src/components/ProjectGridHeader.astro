---
import Cross from "../assets/images/cross.svg";
import Search from "../components/Search.astro";
import Separator from "../components/Separator.astro";
import TextSlider from "../components/TextSlider.astro";
import { useTranslations } from "../i18n/ui";

type Props = {
	projectsTotal: number;
};

const { projectsTotal } = Astro.props;
const t = useTranslations();
---

<!-- is-intro：入場動畫期間先不畫排序底線，文字浮上來後由 index.js 拿掉，底線才畫出 -->
<header class="title-header title-header--initial is-intro">
	<h2 class="sr-only">作品</h2>
	<!-- 「字 ／ 圖」是互斥切換：目前模式全亮、不能點；另一個淡色，滑過只亮起（不轉灰） -->
	<div class="view-toggle" role="group" aria-label={t("grid.viewGroup")}>
		<button data-view-option="type" aria-pressed="true" aria-label={t("grid.viewTypeLabel")}><TextSlider content={t("grid.viewType")} /></button>
		<!-- 斜線也包在 TextSlider 裡，入場時和「字」「圖」一起浮上來 -->
		<span class="view-toggle__sep" aria-hidden="true"><TextSlider content="／" /></span>
		<button data-view-option="image" aria-pressed="false" aria-label={t("grid.viewImageLabel")}><TextSlider content={t("grid.viewImage")} /></button>
	</div>
	<div>
		<!-- 目前的排序（aria-pressed="true"）下方加細底線；搜尋中兩個都不加 -->
		<button data-sort aria-pressed="false"><TextSlider content={t("grid.latest")} /></button>
		<button data-shuffle aria-pressed="true"><TextSlider content={t("grid.random")} /></button>
		<div class="search-tools">
			<!-- 圓角框改成真實元素，入場時才能和文字一樣從下方浮出（::before 無法被 overflow 裁切） -->
			<span class="search-frame-clip" aria-hidden="true"><span class="search-frame"></span></span>
			<button data-search class="search"><TextSlider content={t("grid.search")} /></button>
			<button data-clear class="clear hidden" aria-label={t("grid.clearSearch")}>
				<TextSlider>
					<Cross width={14} height={14} />
				</TextSlider>
			</button>
		</div>
	</div>
	<span><TextSlider content={projectsTotal} /></span>
</header>

<Separator />
<Search />

<style>
	/* 層級：「字／圖」是標題用粗體；最新、隨機、搜尋是操作，用 500（全站操作類統一） */
	button {
		font-weight: 500;
	}
	.view-toggle button {
		font-weight: 700;
		/* 拿掉全站 button 的內距，避免和中間「／」的 hover 區重疊而閃爍 */
		padding: 0;
	}
	div {
		display: flex;
		list-style: none;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	button[data-sort],
	button[data-shuffle],
	.clear {
		flex-shrink: 0;
	}
	/* 全形「／」本身左右已有空間，不再另加間距 */
	.view-toggle {
		flex-shrink: 0;
		gap: 0;
	}
	/* 全形「／」比字略小、往下對齊字身，左右收窄 */
	.view-toggle__sep {
		opacity: 0.35;
		font-size: 0.95em;
		position: relative;
		top: 0.14em;
		margin: 0 -0.06em;
	}
	/* 手機字級較小，斜線稍微往上一點 */
	@media screen and (max-width: 49.99em) {
		.view-toggle__sep {
			top: 0.12em;
		}
	}
	/* 斜線包在 TextSlider 裡：動畫外框靠上對齊，不多出下方空白，位置才和「字」「圖」對齊 */
	.view-toggle__sep :global(.oh) {
		vertical-align: top;
	}
	/* 互斥切換：目前這項不能再點，和導覽「目前頁」一樣關掉滑鼠互動，才不會誤以為能按 */
	[data-view-option][aria-pressed="true"] {
		pointer-events: none;
	}
	[data-view-option][aria-pressed="false"] {
		opacity: 0.35;
		transition: opacity 0.3s;
	}
	/* 「最新／隨機」都全亮（是操作，不是二選一）。底線和內文連結相同（螢光綠、從左畫出）：
	   目前的排序一直有底線，其他的滑過時畫出（和導覽的「目前頁」相同） */
	[data-sort],
	[data-shuffle] {
		position: relative;
	}
	[data-sort]::after,
	[data-shuffle]::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: 0;
		height: 1px;
		width: 0;
		background: var(--color-link-underline);
		transition: width 0.3s ease;
	}
	[data-sort][aria-pressed="true"]::after,
	[data-shuffle][aria-pressed="true"]::after {
		width: 100%;
	}
	.is-intro [data-sort]::after,
	.is-intro [data-shuffle]::after {
		width: 0;
	}
	@media (hover: hover) {
		/* 只亮起、不轉灰：全站 button hover 會把字變成 #999，和亮度回饋互搶，看起來像閃爍 */
		[data-view-option][aria-pressed="false"]:hover {
			opacity: 1;
			color: inherit;
		}
		[data-sort]:hover::after,
		[data-shuffle]:hover::after {
			width: 100%;
		}
		/* 滑到另一個排序、新底線畫出時，目前排序的底線照原本的動畫收回 */
		div:has(> [data-sort]:hover, > [data-shuffle]:hover) > [aria-pressed="true"]:not(:hover)::after {
			width: 0;
		}
	}
	/* 手機：按下可切換的那邊亮起，不要走全站 button 轉灰 */
	@media (hover: none) {
		[data-view-option][aria-pressed="false"]:active {
			opacity: 1;
			color: inherit;
		}
	}
	.search-tools {
		position: relative;
		flex: 0 1 auto;
	}
	.search {
		min-width: 0;
		flex: 1 1 auto;
		overflow: hidden;
	}
	/* TextSlider 的 .oh 會隨文字變寬；限制在按鈕內，過長時省略 */
	.search :global(.oh) {
		display: block;
		min-width: 0;
		flex: 1 1 auto;
		overflow: hidden;
	}
	.search :global(.oh__inner) {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.clear :global(.oh) {
		display: block;
		line-height: 0;
	}
	.search-tools:has(> .search--active) {
		margin-left: 1rem;
	}
	.search-frame-clip {
		position: absolute;
		inset: -0.5rem -1rem;
		overflow: hidden;
		pointer-events: none;
		/* 不用 display:none：換頁時 GSAP 還量得到高度，yPercent 才會真的整框移出裁切 */
		opacity: 0;
	}
	.search-tools:has(> .search--active) .search-frame-clip {
		opacity: 1;
	}
	.search-frame {
		position: absolute;
		inset: 0;
		border: 1px solid;
		border-radius: 2rem;
		box-sizing: border-box;
	}
	/* 點 tag／還原搜尋時 JS 才加上 search--active，入場動畫可能已開始；
	   先用 CSS 把框藏在裁切下方，才不會比文字先停在畫面上 */
	.is-intro .search-frame {
		transform: translateY(calc(100% + 4px));
	}
	.search--active {
		&:focus-visible {
			color: inherit;
		}
	}
</style>

<script src="../scripts/productGridActions.js"></script>
<script src="../scripts/gridViewMode.js"></script>
