---
import Cross from "../assets/images/cross.svg";
import Search from "../components/Search.astro";
import Separator from "../components/Separator.astro";
import TextSlider from "../components/TextSlider.astro";

type Props = {
	projectsTotal: number;
};

const { projectsTotal } = Astro.props;
---

<header class="title-header title-header--initial">
	<h2 class="sr-only">作品</h2>
	<!-- 「字 ／ 圖」就是這一段的標題：顯示中的模式全亮，另一個淡色、滑過亮起 -->
	<div class="view-toggle" role="group" aria-label="瀏覽方式">
		<button data-view-option="type" aria-pressed="true" aria-label="單色字"><TextSlider content="字" /></button>
		<span aria-hidden="true">/</span>
		<button data-view-option="image" aria-pressed="false" aria-label="圖片"><TextSlider content="圖" /></button>
	</div>
	<div>
		<button data-sort><TextSlider content="最新" /></button>
		<button data-shuffle><TextSlider content="隨機" /></button>
		<div>
			<button data-search class="search"><TextSlider content="搜尋" /></button>
			<button data-clear class="clear hidden" aria-label="清除搜尋">
				<Cross width={14} height={14} />
			</button>
		</div>
	</div>
	<span><TextSlider content={projectsTotal} /></span>
</header>

<Separator />
<Search />

<style>
	button {
		font-weight: 700;
	}
	div {
		display: flex;
		list-style: none;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	button[data-sort],
	button[data-shuffle],
	.clear {
		flex-shrink: 0;
	}
	.view-toggle {
		flex-shrink: 0;
		gap: 0.35rem;
	}
	.view-toggle span {
		opacity: 0.35;
	}
	[data-view-option][aria-pressed="false"] {
		opacity: 0.35;
		transition: opacity 0.3s;
	}
	[data-view-option][aria-pressed="false"]:hover {
		opacity: 1;
	}
	div:has(> .search) {
		position: relative;
		flex: 0 1 auto;
	}
	.search {
		min-width: 0;
		flex: 1 1 auto;
		overflow: hidden;
	}
	/* TextSlider 的 .oh 會隨文字變寬；限制在按鈕內，過長時省略 */
	.search :global(.oh) {
		display: block;
		min-width: 0;
		flex: 1 1 auto;
		overflow: hidden;
	}
	.search :global(.oh__inner) {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	div:has(> .search--active) {
		margin-left: 1rem;
	}
	div:has(> .search--active)::before {
		pointer-events: none;
		content: "";
		position: absolute;
		left: -1rem;
		right: -1rem;
		top: -0.5rem;
		bottom: -0.5rem;
		border: 1px solid;
		border-radius: 2rem;
	}
	.search--active {
		&:focus-visible {
			color: inherit;
		}
	}
</style>

<script src="../scripts/productGridActions.js"></script>
<script src="../scripts/gridViewMode.js"></script>
