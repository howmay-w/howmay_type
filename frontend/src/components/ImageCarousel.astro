---
type MediaItem =
	| { type: "image"; src: string; alt?: string }
	| { type: "video"; src: string; poster?: string };

type Props = {
	/** 混合媒體（圖＋影片），影片會依陣列順序出現在輪播中 */
	items?: MediaItem[];
	/** 僅圖片時可沿用舊介面 */
	images?: { src: string; alt?: string }[];
	title: string;
};

const { items: rawItems, images, title } = Astro.props;
const items: MediaItem[] =
	rawItems?.length
		? rawItems
		: (images ?? []).map((img) => ({ type: "image" as const, src: img.src, alt: img.alt }));
const total = items.length;
const slides =
	total > 1
		? [items[total - 1], ...items, items[0]]
		: items;

function getSlideRealIndex(i: number): number {
	if (total <= 1) return i;
	if (i === 0) return total - 1;
	if (i === total + 1) return 0;
	return i - 1;
}
---

<div class="carousel" data-carousel data-total={total} data-has-video={items.some((x) => x.type === "video") ? "true" : undefined}>
	<div class="carousel__track-wrap">
	<div class="carousel__track" role="list">
		{slides.map((item, i) => {
			const realIndex = getSlideRealIndex(i);
			const isVideo = item.type === "video";
			return (
				<div class={`carousel__slide${isVideo ? " carousel__slide--video" : ""}`} role="listitem" data-index={realIndex}>
					{isVideo ? (
						<>
							<div class="carousel__video-wrap">
								<video
									class="carousel__video"
									src={item.src}
									poster={item.poster}
									playsinline
									preload="metadata"
									muted
									tabindex="-1"
								>
									<track kind="captions" />
								</video>
							</div>
							<div class="carousel__video-overlay" data-video-overlay>
								<button type="button" class="carousel__video-play-btn" aria-label="播放／暫停">
									<span class="carousel__video-icon carousel__video-icon--play" aria-hidden="true">
										<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M8 5v14l11-7z" />
										</svg>
									</span>
									<span class="carousel__video-icon carousel__video-icon--pause" aria-hidden="true">
										<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
										</svg>
									</span>
								</button>
								<div class="carousel__video-progress">
									<div class="carousel__video-progress-fill"></div>
								</div>
							</div>
						</>
					) : (
						<img
							src={item.src}
							alt={item.alt ?? `${title} - 圖 ${realIndex + 1}`}
							width="800"
							loading={i <= 1 ? "eager" : "lazy"}
							decoding="async"
							draggable="false"
						/>
					)}
				</div>
			);
		})}
	</div>
	{total > 1 && (
		<>
			<button type="button" class="carousel__btn carousel__btn--prev" aria-label="上一張">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M15 18l-6-6 6-6" />
				</svg>
			</button>
			<button type="button" class="carousel__btn carousel__btn--next" aria-label="下一張">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M9 18l6-6-6-6" />
				</svg>
			</button>
		</>
	)}
	</div>
	{total > 1 && (
		<div class="carousel__dots" role="tablist">
			{items.map((item, i) => (
				<button
					type="button"
					class="carousel__dot"
					role="tab"
					aria-label={item.type === "video" ? `第 ${i + 1} 則（影片）` : `第 ${i + 1} 張`}
					aria-selected={i === 0}
					data-index={i}
				/>
			))}
		</div>
	)}
</div>

<style>
	.carousel {
		position: relative;
		width: 100%;
		margin-top: 1rem;
	}
	.carousel__track-wrap {
		position: relative;
	}
	.carousel__track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		gap: 0;
		cursor: grab;
		user-select: none;
		touch-action: pan-y;
		/* 隱藏捲軸，避免滑動時出現上下黑條 */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.carousel__track::-webkit-scrollbar {
		display: none;
	}
	.carousel__track:active {
		cursor: grabbing;
	}
	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}
	.carousel__slide--video {
		position: relative;
	}
	.carousel__slide picture,
	.carousel__slide img,
	.carousel__slide .carousel__video-wrap,
	.carousel__slide .carousel__video {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		background: var(--color-placeholder, #f8f8f8);
	}
	/* 影片留白處與圖片 placeholder 同色，避免切到影片時出現黑邊／與上一張露白對比 */
	.carousel__slide--video,
	.carousel__slide--video .carousel__video-wrap,
	.carousel__slide--video .carousel__video {
		background: var(--color-placeholder, #f8f8f8);
	}
	.carousel__video-wrap {
		position: relative;
	}
	.carousel__video {
		vertical-align: middle;
	}
	/* 自訂影片 overlay：播放／暫停 + 進度條，hover 與箭頭一起出現，僅圓圈半透明黑底 */
	.carousel__video-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.25s ease;
		cursor: pointer;
	}
	.carousel:hover .carousel__video-overlay {
		opacity: 1;
	}
	.carousel__video-play-btn {
		width: 3.5rem;
		height: 3.5rem;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s, transform 0.2s;
	}
	.carousel__video-play-btn:hover {
		background: rgba(0, 0, 0, 0.6);
	}
	.carousel__video-play-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
	.carousel__video-icon {
		display: none;
		width: 2rem;
		height: 2rem;
	}
	.carousel__video-icon svg {
		width: 100%;
		height: 100%;
	}
	.carousel__video-play-btn[data-playing="false"] .carousel__video-icon--play,
	.carousel__video-play-btn[data-playing="true"] .carousel__video-icon--pause {
		display: block;
	}
	.carousel__video-progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		background: rgba(255, 255, 255, 0.25);
		pointer-events: none;
	}
	.carousel__video-progress-fill {
		height: 100%;
		width: 0%;
		background: rgba(255, 255, 255, 0.9);
		transition: width 0.1s linear;
	}
	.carousel__track-wrap .carousel__btn {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 20%;
		min-width: 4rem;
		max-width: 4rem;
		border: none;
		background: none;
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.25s ease;
		z-index: 2;
	}
	.carousel:hover .carousel__track-wrap .carousel__btn {
		opacity: 1;
	}
	.carousel__btn--prev {
		left: 0;
	}
	.carousel__btn--next {
		right: 0;
	}
	.carousel__dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}
	.carousel__dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		border: none;
		background: var(--color-faded);
		cursor: pointer;
		transition: background 0.2s;
	}
	.carousel__dot[aria-selected="true"],
	.carousel__dot:hover {
		background: var(--color-text-alt);
	}
</style>

<script>
	function initCarousel() {
		const carousel = document.querySelector("[data-carousel]:not([data-carousel-inited])");
		if (!carousel) return;
		(carousel as HTMLElement).dataset.carouselInited = "true";

		const track = carousel.querySelector(".carousel__track") as HTMLElement | null;
		const prevBtn = carousel.querySelector(".carousel__btn--prev");
		const nextBtn = carousel.querySelector(".carousel__btn--next");
		const dots = carousel.querySelectorAll(".carousel__dot");
		const total = parseInt(carousel.getAttribute("data-total") ?? "0", 10);

		if (total <= 1 || !track) return;

		// DOM 結構：[clone_last, real_0 … real_(N-1), clone_first]
		// 捲動位置：clone_last=0, real_i=(i+1)*sw, clone_first=(total+1)*sw

		const sw = () => track.offsetWidth;

		let index = 0;
		let isDragging = false;
		let startX = 0;
		let startScrollLeft = 0;
		let teleportTimer: ReturnType<typeof setTimeout> | null = null;
		let isReady = false;

		// 等兩個 rAF，確保 View Transition 與 layout 都穩定後再設定起始位置
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = sw();
				track.style.scrollBehavior = "smooth";
				isReady = true;
				updateVideoPlayback();
			});
		});

		function setDots(i: number) {
			dots.forEach((dot, j) =>
				dot.setAttribute("aria-selected", j === i ? "true" : "false")
			);
		}

		// 依「目前可見的 slide」切換播放，避免 Safari 在捲動中頻繁切換導致卡頓／glitch
		function updateVideoPlayback() {
			if (!carousel.hasAttribute("data-has-video")) return;
			track.querySelectorAll("video").forEach((v) => {
				v.pause();
			});
			const domIndex = Math.round(track.scrollLeft / sw());
			const slide = track.children[domIndex];
			const video = slide?.querySelector("video");
			if (video) {
				requestAnimationFrame(() => {
					video.currentTime = 0;
					video.play().catch(() => {});
				});
			}
		}

		function initVideoOverlays() {
			if (!carousel.hasAttribute("data-has-video")) return;
			track.querySelectorAll(".carousel__slide--video").forEach((slide) => {
				const video = slide.querySelector("video");
				const overlay = slide.querySelector("[data-video-overlay]") as HTMLElement | null;
				if (!video || !overlay) return;
				const playBtn = overlay.querySelector(".carousel__video-play-btn") as HTMLButtonElement | null;
				const progressFill = overlay.querySelector(".carousel__video-progress-fill") as HTMLElement | null;

				function updateUI() {
					const playing = !video.paused;
					if (playBtn) {
						playBtn.setAttribute("data-playing", String(playing));
						playBtn.setAttribute("aria-label", playing ? "暫停" : "播放");
					}
					if (progressFill && Number.isFinite(video.duration) && video.duration > 0) {
						progressFill.style.width = `${(video.currentTime / video.duration) * 100}%`;
					}
				}

				function togglePlay() {
					if (video.paused) video.play().catch(() => {});
					else video.pause();
				}

				video.addEventListener("play", updateUI);
				video.addEventListener("pause", updateUI);
				video.addEventListener("timeupdate", updateUI);
				video.addEventListener("loadedmetadata", updateUI);
				updateUI();

				overlay.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					togglePlay();
				});
			});
		}
		initVideoOverlays();

		function goTo(i: number) {
			index = ((i % total) + total) % total;
			track.scrollTo({ left: (index + 1) * sw(), behavior: "smooth" });
			setDots(index);
		}

		let videoUpdateTimer: ReturnType<typeof setTimeout> | null = null;

		// 捲動停止後，若停在複製張則靜默傳送到對應的真實張
		function maybeTeleport() {
			const s = sw();
			const left = track.scrollLeft;
			if (left < s * 0.5) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = total * s;
				track.style.scrollBehavior = "smooth";
				index = total - 1;
				setDots(index);
			} else if (left > (total + 0.5) * s) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = s;
				track.style.scrollBehavior = "smooth";
				index = 0;
				setDots(index);
			}
			updateVideoPlayback();
		}

		function scheduleTeleport() {
			if (teleportTimer !== null) clearTimeout(teleportTimer);
			teleportTimer = setTimeout(() => {
				teleportTimer = null;
				maybeTeleport();
			}, 80);
		}

		// scroll 期間即時更新點點，停止後安排傳送；影片切換改為捲動停止後才執行，減少 Safari glitch
		function onScroll() {
			const s = sw();
			const dom = Math.round(track.scrollLeft / s);
			const di = dom <= 0 ? total - 1 : dom >= total + 1 ? 0 : dom - 1;
			setDots(di);
			scheduleTeleport();
			if (videoUpdateTimer != null) clearTimeout(videoUpdateTimer);
			videoUpdateTimer = setTimeout(() => {
				videoUpdateTimer = null;
				updateVideoPlayback();
			}, 120);
		}

		// ── 按鈕：往右包回時順向捲至右側 clone，不往左跳 ──────────
		prevBtn?.addEventListener("click", () => {
			if (!isReady) return;
			if (index === 0) {
				// 向左捲至 clone_last，停止後傳送到真實最後一張
				index = total - 1;
				track.scrollTo({ left: 0, behavior: "smooth" });
				setDots(index);
			} else {
				goTo(index - 1);
			}
		});

		nextBtn?.addEventListener("click", () => {
			if (!isReady) return;
			if (index === total - 1) {
				// 向右捲至 clone_first，停止後傳送到真實第一張
				index = 0;
				track.scrollTo({ left: (total + 1) * sw(), behavior: "smooth" });
				setDots(index);
			} else {
				goTo(index + 1);
			}
		});

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				if (!isReady) return;
				goTo(i);
			});
		});

		track.addEventListener("scroll", onScroll);

		// ── 拖曳 ────────────────────────────────────────────────────
		function startDrag(clientX: number) {
			if (!isReady) return;
			isDragging = true;
			startX = clientX;
			startScrollLeft = track.scrollLeft;
			if (teleportTimer !== null) { clearTimeout(teleportTimer); teleportTimer = null; }
			track.style.scrollBehavior = "auto";
		}

		function doDrag(clientX: number) {
			if (!isDragging) return;
			track.scrollLeft = startScrollLeft - (clientX - startX);
		}

		function endDrag() {
			if (!isDragging) return;
			isDragging = false;
			track.style.scrollBehavior = "smooth";

			const s = sw();
			const domIndex = Math.round(track.scrollLeft / s);

			if (domIndex <= 0) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = total * s;
				track.style.scrollBehavior = "smooth";
				index = total - 1;
				setDots(index);
			} else if (domIndex >= total + 1) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = s;
				track.style.scrollBehavior = "smooth";
				index = 0;
				setDots(index);
			} else {
				index = domIndex - 1;
				setDots(index);
				track.scrollTo({ left: domIndex * s, behavior: "smooth" });
			}
			updateVideoPlayback();
		}

		track.addEventListener("pointerdown", (e: PointerEvent) => {
			if (e.pointerType === "mouse" && e.button !== 0) return;
			if ((e.target as Element).closest("[data-video-overlay]")) return;
			startDrag(e.clientX);
			try { track.setPointerCapture(e.pointerId); } catch (_) {}
		});

		track.addEventListener(
			"pointermove",
			(e: PointerEvent) => {
				if (!isDragging) return;
				e.preventDefault();
				doDrag(e.clientX);
			},
			{ passive: false },
		);

		track.addEventListener("pointerup", (e: PointerEvent) => {
			try { track.releasePointerCapture(e.pointerId); } catch (_) {}
			endDrag();
		});
		track.addEventListener("pointercancel", endDrag);

		track.addEventListener(
			"touchstart",
			(e: TouchEvent) => {
				if (e.touches.length !== 1) return;
				if ((e.target as Element).closest("[data-video-overlay]")) return;
				startDrag(e.touches[0].clientX);
			},
			{ passive: true },
		);

		track.addEventListener(
			"touchmove",
			(e: TouchEvent) => {
				if (!isDragging || e.touches.length !== 1) return;
				e.preventDefault();
				doDrag(e.touches[0].clientX);
			},
			{ passive: false },
		);

		track.addEventListener(
			"touchend",
			(e: TouchEvent) => {
				if (e.changedTouches.length) endDrag();
			},
			{ passive: true },
		);

		track.addEventListener("touchcancel", endDrag);
	}

	initCarousel();
	document.addEventListener("astro:page-load", initCarousel);
</script>
