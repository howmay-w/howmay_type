---
type MediaItem =
	| { type: "image"; src: string; alt?: string }
	| { type: "video"; src: string; poster?: string };

type Props = {
	/** 混合媒體（圖＋影片），影片會依陣列順序出現在輪播中 */
	items?: MediaItem[];
	/** 僅圖片時可沿用舊介面 */
	images?: { src: string; alt?: string }[];
	title: string;
};

const { items: rawItems, images, title } = Astro.props;
const items: MediaItem[] =
	rawItems?.length
		? rawItems
		: (images ?? []).map((img) => ({ type: "image" as const, src: img.src, alt: img.alt }));
const total = items.length;
const slides =
	total > 1
		? [items[total - 1], ...items, items[0]]
		: items;

function getSlideRealIndex(i: number): number {
	if (total <= 1) return i;
	if (i === 0) return total - 1;
	if (i === total + 1) return 0;
	return i - 1;
}
---

<div class="carousel" data-carousel data-total={total} data-loop={total > 1 ? "true" : undefined} data-has-video={items.some((x) => x.type === "video") ? "true" : undefined}>
	<div class="carousel__track-wrap">
	<div class="carousel__track" role="list">
		{slides.map((item, i) => {
			const realIndex = getSlideRealIndex(i);
			const isVideo = item.type === "video";
			return (
				<div class={`carousel__slide${isVideo ? " carousel__slide--video" : ""}`} role="listitem" data-index={realIndex}>
					{isVideo ? (
						<>
							<div class="carousel__video-wrap">
								<video
									class="carousel__video"
									src={item.src}
									poster={item.poster}
									playsinline
									preload="metadata"
									muted
									tabindex="-1"
								>
									<track kind="captions" />
								</video>
							</div>
							<div class="carousel__video-overlay" data-video-overlay>
								<button type="button" class="carousel__video-play-btn" aria-label="播放／暫停">
									<span class="carousel__video-icon carousel__video-icon--play" aria-hidden="true">
										<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M8 5v14l11-7z" />
										</svg>
									</span>
									<span class="carousel__video-icon carousel__video-icon--pause" aria-hidden="true">
										<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
										</svg>
									</span>
								</button>
								<div class="carousel__video-progress">
									<div class="carousel__video-progress-fill"></div>
								</div>
							</div>
						</>
					) : (
						<img
							src={item.src}
							alt={item.alt ?? `${title} - 圖 ${realIndex + 1}`}
							width="800"
							loading={i <= 1 ? "eager" : "lazy"}
							decoding="async"
							draggable="false"
						/>
					)}
				</div>
			);
		})}
	</div>
	{total > 1 && (
		<>
			<button type="button" class="carousel__btn carousel__btn--prev" aria-label="上一張">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
					<path d="M15 18l-6-6 6-6" />
				</svg>
			</button>
			<button type="button" class="carousel__btn carousel__btn--next" aria-label="下一張">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
					<path d="M9 18l6-6-6-6" />
				</svg>
			</button>
		</>
	)}
	</div>
	{total > 1 && (
		<div class="carousel__dots" role="tablist">
			{items.map((item, i) => (
				<button
					type="button"
					class="carousel__dot"
					role="tab"
					aria-label={item.type === "video" ? `第 ${i + 1} 則（影片）` : `第 ${i + 1} 張`}
					aria-selected={i === 0}
					data-index={i}
				/>
			))}
		</div>
	)}
</div>

<style>
	.carousel {
		position: relative;
		width: 100%;
		margin-top: 1rem;
	}
	.carousel__track-wrap {
		position: relative;
	}
	.carousel__track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		gap: 0;
		user-select: none;
		/* 允許水平拖曳／滑動，觸控與滑鼠一致 */
		touch-action: pan-x;
		/* 隱藏捲軸，避免滑動時出現上下黑條 */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.carousel__track::-webkit-scrollbar {
		display: none;
	}
	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}
	/* 最前面是最後一張的複本，捲動位置 0 會先露出它。
	   對準第一張之前先把這張複本收成寬度 0，換頁動畫拍到的就是第一張。
	   不用位移：位移和捲動會各跳一格，停下來會多一張。 */
	.carousel[data-loop]:not([data-carousel-placed]) .carousel__slide:first-child {
		flex: 0 0 0;
		width: 0;
		min-width: 0;
		overflow: hidden;
		visibility: hidden;
		scroll-snap-align: none;
	}
	.carousel[data-loop]:not([data-carousel-placed]) .carousel__track {
		pointer-events: none;
	}
	.carousel__slide--video {
		position: relative;
	}
	.carousel__slide picture,
	.carousel__slide img,
	.carousel__slide .carousel__video-wrap,
	.carousel__slide .carousel__video {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		background: var(--color-placeholder, #f8f8f8);
	}
	/* 影片留白處與圖片 placeholder 同色，避免切到影片時出現黑邊／與上一張露白對比 */
	.carousel__slide--video,
	.carousel__slide--video .carousel__video-wrap,
	.carousel__slide--video .carousel__video {
		background: var(--color-placeholder, #f8f8f8);
	}
	.carousel__video-wrap {
		position: relative;
	}
	.carousel__video {
		vertical-align: middle;
	}
	/* iOS 在影片播完時會蓋上系統的重播圓箭頭，改由下面的播放鈕接手 */
	.carousel__video::-webkit-media-controls-overlay-play-button,
	.carousel__video::-webkit-media-controls-start-playback-button {
		display: none !important;
		-webkit-appearance: none;
	}
	/* 自訂影片 overlay：播放／暫停 + 進度條，hover 與箭頭一起出現，僅圓圈半透明黑底 */
	.carousel__video-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.25s ease;
		cursor: pointer;
	}
	/* 觸控裝置沒有 hover，點一下後 :hover 會一直留著，按鈕就不會消失；hover 只給滑鼠用，
	   觸控時由 script 加 data-show（點按後短暫顯示、暫停或播完時保留） */
	@media (hover: hover) {
		.carousel:hover .carousel__video-overlay {
			opacity: 1;
		}
	}
	.carousel__video-overlay[data-show] {
		opacity: 1;
	}
	.carousel__video-play-btn {
		width: 3.5rem;
		height: 3.5rem;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s, transform 0.2s;
	}
	.carousel__video-play-btn:hover {
		background: rgba(0, 0, 0, 0.6);
	}
	.carousel__video-play-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
	.carousel__video-icon {
		display: none;
		width: 2rem;
		height: 2rem;
	}
	.carousel__video-icon svg {
		width: 100%;
		height: 100%;
	}
	.carousel__video-play-btn[data-playing="false"] .carousel__video-icon--play,
	.carousel__video-play-btn[data-playing="true"] .carousel__video-icon--pause {
		display: block;
	}
	.carousel__video-progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		background: rgba(255, 255, 255, 0.25);
		pointer-events: none;
	}
	.carousel__video-progress-fill {
		height: 100%;
		width: 0%;
		background: rgba(255, 255, 255, 0.9);
		transition: width 0.1s linear;
	}
	.carousel__track-wrap .carousel__btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 2.5rem;
		height: 2.5rem;
		border: none;
		background: none;
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.25s ease;
		z-index: 2;
	}
	.carousel:hover .carousel__track-wrap .carousel__btn {
		opacity: 1;
	}
	.carousel__btn--prev {
		left: 0;
	}
	.carousel__btn--next {
		right: 0;
	}
	.carousel__dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}
	.carousel__dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		border: none;
		background: var(--color-faded);
		cursor: pointer;
		transition: background 0.2s;
	}
	.carousel__dot[aria-selected="true"],
	.carousel__dot:hover {
		background: var(--color-text-alt);
	}
</style>

<script>
	function initCarousel() {
		const carousel = document.querySelector("[data-carousel]:not([data-carousel-inited])");
		if (!carousel) return;
		(carousel as HTMLElement).dataset.carouselInited = "true";

		const track = carousel.querySelector(".carousel__track") as HTMLElement | null;
		const prevBtn = carousel.querySelector(".carousel__btn--prev");
		const nextBtn = carousel.querySelector(".carousel__btn--next");
		const dots = carousel.querySelectorAll(".carousel__dot");
		const total = parseInt(carousel.getAttribute("data-total") ?? "0", 10);

		if (total <= 1 || !track) return;

		// DOM 結構：[clone_last, real_0 … real_(N-1), clone_first]
		// 捲動位置：clone_last=0, real_i=(i+1)*sw, clone_first=(total+1)*sw

		const sw = () => track.offsetWidth;

		let index = 0;
		let teleportTimer: ReturnType<typeof setTimeout> | null = null;
		let isReady = false;

		// 隨機是整頁重新載入，沒有換頁動畫，輪播一出現就可以定位、播放。
		// 首頁點進來、上一篇、下一篇走站內換頁：astro:page-load 時動畫還在跑
		// （html 上有 data-astro-transition）。這時候設定的捲動位置不會留住，
		// 影片也被瀏覽器凍結，播了也不動。等動畫拿掉那個屬性再開始。
		const begin = (afterTransition: boolean) => {
			if (isReady) return;
			if (afterTransition) {
				track.querySelectorAll("video").forEach((node) => {
					(node as HTMLVideoElement).load();
				});
			}
			let placeAttempts = 0;
			const place = () => {
				const width = sw();
				if (!width) {
					requestAnimationFrame(place);
					return;
				}
				track.style.scrollBehavior = "auto";
				// 先展開複本，同一輪再把捲動對到第一張，瀏覽器才不會先畫出最後一張。
				(carousel as HTMLElement).dataset.carouselPlaced = "true";
				const slideWidth = (track.firstElementChild as HTMLElement | null)?.offsetWidth || width;
				track.scrollLeft = slideWidth;
				// 換頁動畫期間寫進去的位置會被清掉。複本先收回去，畫面仍是第一張，下一幀再對一次。
				if (Math.abs(track.scrollLeft - slideWidth) > 1 && placeAttempts < 10) {
					delete (carousel as HTMLElement).dataset.carouselPlaced;
					placeAttempts += 1;
					requestAnimationFrame(place);
					return;
				}
				track.style.scrollBehavior = "smooth";
				isReady = true;
				updateVideoPlayback();
			};
			requestAnimationFrame(place);
		};
		const root = document.documentElement;
		if (!root.hasAttribute("data-astro-transition")) {
			begin(false);
		} else {
			let settled = false;
			const finish = () => {
				if (settled) return;
				settled = true;
				obs.disconnect();
				clearTimeout(backup);
				begin(true);
			};
			const obs = new MutationObserver(() => {
				if (!root.hasAttribute("data-astro-transition")) finish();
			});
			obs.observe(root, { attributes: true, attributeFilter: ["data-astro-transition"] });
			const backup = setTimeout(finish, 1200);
		}

		function setDots(i: number) {
			dots.forEach((dot, j) =>
				dot.setAttribute("aria-selected", j === i ? "true" : "false")
			);
		}

		// 依「目前可見的 slide」切換播放，避免 Safari 在捲動中頻繁切換導致卡頓／glitch。
		// 停在同一支影片上就不動：捲動停止後會呼叫好幾次（傳送檢查、捲動計時器），iOS 回彈或版面變動也會送出捲動事件，
		// 每次都暫停、跳回開頭再播放的話，影片會一直重播、按鈕在播放／暫停之間閃動
		let activeVideo: HTMLVideoElement | null = null;
		// 換片或使用者按暫停時，作廢還沒完成的「拉回開頭再播」
		let playGen = 0;
		const overlayOf = (video: HTMLVideoElement) =>
			video.closest(".carousel__slide")?.querySelector("[data-video-overlay]") as HTMLElement | null;

		function playVideo(video: HTMLVideoElement, attempt = 0) {
			const gen = playGen;
			// 明確設定靜音：沒有靜音的影片，瀏覽器不允許自動播放
			video.muted = true;
			video.play().then(() => {
				// 已經換到別張，把這次補播停掉
				if (activeVideo !== video && !video.paused) video.pause();
			}).catch((err: DOMException) => {
				if (gen !== playGen || activeVideo !== video) return;
				// 從首頁點進來時，換頁動畫會把這次播放打斷（AbortError，Safari 有時報 NotAllowedError）。
				// 打斷之後這張已被記成正在處理，不再試的話影片就停在開頭
				if ((err.name === "AbortError" || err.name === "NotAllowedError") && attempt < 8) {
					setTimeout(() => {
						if (gen !== playGen || activeVideo !== video || !video.paused) return;
						playVideo(video, attempt + 1);
					}, 250);
					return;
				}
				console.warn("[carousel] 影片無法自動播放：", err.name, err.message);
				overlayOf(video)?.setAttribute("data-show", "");
			});
		}

		// 先拉回開頭，等這次 seek 完成再播放。
		// 同一個回合裡又設定 currentTime 又 play()，瀏覽器會把播放送到片尾並立刻結束，
		// 畫面停住，再按播放也一樣。首頁預覽過同一支影片、或這支剛播完時最容易發生。
		// 資料還沒到就設定 currentTime，Safari 會丟 InvalidStateError，play() 跟著沒被呼叫
		function playFromStart(video: HTMLVideoElement) {
			const gen = ++playGen;
			const begin = () => {
				if (gen !== playGen || activeVideo !== video) return;
				if (video.currentTime < 0.05 && !video.seeking && !video.ended) {
					playVideo(video);
					return;
				}
				const onSeeked = () => {
					video.removeEventListener("seeked", onSeeked);
					if (gen !== playGen || activeVideo !== video) return;
					playVideo(video);
				};
				video.addEventListener("seeked", onSeeked);
				try {
					video.currentTime = 0;
				} catch {
					video.removeEventListener("seeked", onSeeked);
					if (video.readyState === 0) video.addEventListener("loadedmetadata", begin, { once: true });
					else playVideo(video);
					return;
				}
				// 已經在開頭時，設定 currentTime 不會送出 seeked，要直接播
				if (!video.seeking && video.currentTime < 0.05) {
					video.removeEventListener("seeked", onSeeked);
					playVideo(video);
				}
			};
			if (video.readyState >= 1) begin();
			else video.addEventListener("loadedmetadata", begin, { once: true });
		}

		function updateVideoPlayback() {
			if (!carousel.hasAttribute("data-has-video")) return;
			const domIndex = Math.round(track.scrollLeft / sw());
			const slide = track.children[domIndex];
			const video = slide?.querySelector("video") ?? null;
			if (video === activeVideo) return;
			track.querySelectorAll("video").forEach((v) => {
				if (v !== video && !v.paused) v.pause();
			});
			activeVideo = video;
			if (video) playFromStart(video);
			else playGen++;
		}

		function initVideoOverlays() {
			if (!carousel.hasAttribute("data-has-video")) return;
			track.querySelectorAll(".carousel__slide--video").forEach((slide) => {
				const video = slide.querySelector("video");
				const overlay = slide.querySelector("[data-video-overlay]") as HTMLElement | null;
				if (!video || !overlay) return;
				const playBtn = overlay.querySelector(".carousel__video-play-btn") as HTMLButtonElement | null;
				const progressFill = overlay.querySelector(".carousel__video-progress-fill") as HTMLElement | null;
				let hideTimer: ReturnType<typeof setTimeout> | null = null;

				function updateUI() {
					const playing = !video.paused;
					if (playBtn) {
						playBtn.setAttribute("data-playing", String(playing));
						playBtn.setAttribute("aria-label", playing ? "暫停" : "播放");
					}
					if (progressFill && Number.isFinite(video.duration) && video.duration > 0) {
						progressFill.style.width = `${(video.currentTime / video.duration) * 100}%`;
					}
				}

				// 點按後短暫顯示按鈕；播放中 1.5 秒後收起，暫停時留著
				function flash() {
					overlay.setAttribute("data-show", "");
					if (hideTimer !== null) clearTimeout(hideTimer);
					hideTimer = setTimeout(() => {
						hideTimer = null;
						if (!video.paused) overlay.removeAttribute("data-show");
					}, 1500);
				}

				function togglePlay() {
					if (video.paused) {
						activeVideo = video;
						// 停在片尾時要等拉回開頭完成再播，否則會立刻又被送到片尾
						if (video.ended || (Number.isFinite(video.duration) && video.currentTime >= video.duration - 0.15)) playFromStart(video);
						else playVideo(video);
					} else {
						playGen++;
						video.pause();
					}
				}

				video.addEventListener("play", () => {
					updateUI();
					if (hideTimer === null) overlay.removeAttribute("data-show");
				});
				video.addEventListener("pause", updateUI);
				video.addEventListener("ended", () => {
					overlay.setAttribute("data-show", "");
					// 離開 ended，iOS 才不會顯示系統的重播圖示；停在片尾，按鈕維持播放
					const hold = Math.max(0, (video.duration || 0) - 0.05);
					if (hold > 0) video.currentTime = hold;
					updateUI();
				});
				video.addEventListener("timeupdate", updateUI);
				video.addEventListener("loadedmetadata", updateUI);
				updateUI();

				overlay.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					togglePlay();
					flash();
				});
			});
		}
		initVideoOverlays();

		function goTo(i: number) {
			index = ((i % total) + total) % total;
			track.scrollTo({ left: (index + 1) * sw(), behavior: "smooth" });
			setDots(index);
		}

		let videoUpdateTimer: ReturnType<typeof setTimeout> | null = null;

		// 捲動停止後，若停在複製張則靜默傳送到對應的真實張
		function maybeTeleport() {
			const s = sw();
			const left = track.scrollLeft;
			if (left < s * 0.5) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = total * s;
				track.style.scrollBehavior = "smooth";
				index = total - 1;
				setDots(index);
			} else if (left > (total + 0.5) * s) {
				track.style.scrollBehavior = "auto";
				track.scrollLeft = s;
				track.style.scrollBehavior = "smooth";
				index = 0;
				setDots(index);
			}
			updateVideoPlayback();
		}

		function scheduleTeleport() {
			if (teleportTimer !== null) clearTimeout(teleportTimer);
			teleportTimer = setTimeout(() => {
				teleportTimer = null;
				maybeTeleport();
			}, 80);
		}

		// scroll 期間即時更新點點與 index（供按鈕用），停止後安排傳送；影片切換改為捲動停止後才執行，減少 Safari glitch
		function onScroll() {
			if (!isReady) return;
			const s = sw();
			const dom = Math.round(track.scrollLeft / s);
			const di = dom <= 0 ? total - 1 : dom >= total + 1 ? 0 : dom - 1;
			index = di;
			setDots(di);
			scheduleTeleport();
			if (videoUpdateTimer != null) clearTimeout(videoUpdateTimer);
			videoUpdateTimer = setTimeout(() => {
				videoUpdateTimer = null;
				updateVideoPlayback();
			}, 120);
		}

		// ── 按鈕：往右包回時順向捲至右側 clone，不往左跳 ──────────
		prevBtn?.addEventListener("click", () => {
			if (!isReady) return;
			if (index === 0) {
				// 向左捲至 clone_last，停止後傳送到真實最後一張
				index = total - 1;
				track.scrollTo({ left: 0, behavior: "smooth" });
				setDots(index);
			} else {
				goTo(index - 1);
			}
		});

		nextBtn?.addEventListener("click", () => {
			if (!isReady) return;
			if (index === total - 1) {
				// 向右捲至 clone_first，停止後傳送到真實第一張
				index = 0;
				track.scrollTo({ left: (total + 1) * sw(), behavior: "smooth" });
				setDots(index);
			} else {
				goTo(index + 1);
			}
		});

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				if (!isReady) return;
				goTo(i);
			});
		});

		track.addEventListener("scroll", onScroll);
	}

	initCarousel();
	document.addEventListener("astro:page-load", initCarousel);
</script>
