---
import Separator from "../components/Separator.astro";
---

<Separator />
<footer class="hover-underline-animated">
  <p class="credit">
    美術字 & 標準字創作
    <a href="https://www.instagram.com/howmay__/" target="_blank" rel="noopener noreferrer">
      @howmay__ 
    </a>
  </p>
  <p class="copy">
    <a href="/rss.xml" title="訂閱 RSS" target="_blank" rel="noopener noreferrer">訂閱 RSS</a>
    <span class="sep">·</span>
    © 2025
  </p>
</footer>
<style>
  footer {
    padding: 2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  p {
    margin: 0;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-alt);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .sep {
    margin: 0 0.35em;
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    footer p {
      font-size: 0.85rem;
    }
  }
</style>
