---
import Separator from "../components/Separator.astro";
import TextSlider from "../components/TextSlider.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations();

// Get the current pathname
const currentPath = Astro.url.pathname;
// Define a map of routes
const routes = {
	"/": "Home",
	"/about": "About",
	"/releases": "Releases",
	"/history": "History",
	"/contact": "Contact",
};
// Determine the active route
// 正式站網址結尾有斜線（/about/），先去掉再比對
const activeRoute = routes[currentPath.replace(/(.)\/$/, "$1")] || null;
---

<!-- 換頁時保留同一個頁頭元素（不重新產生、不參與淡入淡出），手機上就不會閃一下；
     「目前頁」的底線由下方的 script 在換頁後更新 -->
<header transition:persist="site-header" transition:animate="none">
  <h1>
    <!-- 站名也可以回首頁（和右邊副標相同），滑過轉灰 -->
    <a href="/" data-home-link data-astro-prefetch><TextSlider content="Howmay 皓梅" /></a>
  </h1>
  <a href="/" class={`header-subtitle ${activeRoute === "Home" ? "current" : ""}`} data-home-link data-astro-prefetch>
    <TextSlider content="Lettering & Logotype" />
    <span class="header-subtitle__line2"><TextSlider content="美術字 & 標準字" /></span>
  </a>
  <ul>
    <li>
      <a
        href="/about"
        class={activeRoute === "About" ? "current" : ""}
        data-astro-prefetch><TextSlider content={t("nav.about")} /></a>
    </li>
    <li>
      <a
        href="/contact"
        class={activeRoute === "Contact" ? "current" : ""}
        data-astro-prefetch><TextSlider content={t("nav.contact")} /></a>
    </li>
  </ul>
</header>
<Separator />

<script>
  // 頁頭在換頁時保留（transition:persist），伺服器端算好的 .current 不會跟著換，要自己依網址更新。
  // 一點下去（開始換頁前）就換：舊底線收回、新底線畫出，和下方頁面的轉換同時進行。
  // 換頁時頁頭會被暫時移出頁面，CSS 轉場會被瀏覽器取消而直接跳到結果，
  // 所以底線改用 Web Animations 播，換頁後從同一個進度接著播完
  const DURATION = 300; // 和 CSS 的 width 0.3s ease 一致
  let startedAt = 0;
  let moves: { el: HTMLAnchorElement; from: string; to: string }[] = [];

  const links = () => document.querySelectorAll<HTMLAnchorElement>("header[data-astro-transition-persist] ul a[href]");
  const play = (elapsed: number) => {
    for (const { el, from, to } of moves) {
      for (const a of el.getAnimations({ subtree: true })) if (a.id === "nav-underline") a.cancel();
      const anim = el.animate([{ width: from }, { width: to }], {
        duration: DURATION,
        easing: "ease",
        pseudoElement: "::after",
        id: "nav-underline",
      });
      anim.currentTime = Math.min(elapsed, DURATION);
    }
  };
  const markCurrent = (pathname: string, animate: boolean) => {
    const path = pathname.replace(/(.)\/$/, "$1");
    const next: typeof moves = [];
    for (const a of links()) {
      const on = a.getAttribute("href") === path;
      if (on !== a.classList.contains("current")) next.push({ el: a, from: on ? "0%" : "100%", to: on ? "100%" : "0%" });
      a.classList.toggle("current", on);
    }
    // 子連結（站名、副標）也同步 .current
    for (const a of document.querySelectorAll<HTMLAnchorElement>("header[data-astro-transition-persist] > a[href], header[data-astro-transition-persist] h1 a[href]")) {
      a.classList.toggle("current", a.getAttribute("href") === path);
    }
    if (!animate || !next.length) return;
    moves = next;
    startedAt = performance.now();
    play(0);
  };

  // 已在首頁時不要整頁重載：View Transition 會把整面字牆一起淡出／閃現。
  // 改通知作品牆用和「隨機」相同的上浮動畫。新分頁、其他頁回首頁仍走原本的連結。
  document.addEventListener(
    "click",
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>(
        "a[data-home-link], header[data-astro-transition-persist] h1 a[href='/'], header[data-astro-transition-persist] > a[href='/']",
      );
      if (!a) return;
      const here = location.pathname.replace(/\/$/, "") || "/";
      if (here !== "/") return;
      e.preventDefault();
      e.stopPropagation();
      document.dispatchEvent(new CustomEvent("home:replay"));
    },
    true,
  );

  document.addEventListener("astro:before-preparation", (e) => {
    markCurrent((e as Event & { to: URL }).to.pathname, true);
  });
  document.addEventListener("astro:after-swap", () => {
    // 換頁後：動畫若還沒播完就從原本的進度接著播；網址和預期不同（上一頁、被導向）時照實際網址重新播
    const elapsed = performance.now() - startedAt;
    const before = moves;
    markCurrent(location.pathname, true);
    if (moves === before && elapsed < DURATION) play(elapsed);
  });
</script>

<style>
  header {
    position: relative;
    display: grid;
    grid-template-columns: min-content auto;
    align-items: baseline;
    /* 字重只用實際載入的 400／500／700：Zen Kaku 沒有 600，設 600 時中文顯示 700、英文 600，粗細不一致 */
    font-weight: 700;
    padding: 1rem 0;
    gap: 1rem;
    z-index: 3;
  }
  /* 已在該頁的導覽不能再點；副標（回首頁）不受影響，在首頁滑過也會轉灰 */
  ul a.current {
    pointer-events: none;
  }
  /* 導覽底線和內文連結相同（螢光綠、從左畫出）：目前所在的頁面一直有底線，其他滑過時畫出
     （和首頁「最新／隨機」標示目前排序相同） */
  ul a {
    position: relative;
    /* 字級縮小後依基線對齊，字頂會比左側低約 0.9px，往上補回，三組字上緣對齊 */
    top: -0.055em;
  }
  ul a::after {
    content: "";
    position: absolute;
    left: 0;
    /* 底線和字底留約 5px（上緣對齊後連結的框變矮，貼著框底會太靠近字） */
    bottom: -0.22em;
    height: 1px;
    width: 0;
    background: var(--color-link-underline);
    transition: width 0.3s ease;
  }
  ul a.current::after {
    width: 100%;
  }
  @media (hover: hover) {
    ul a:hover::after {
      width: 100%;
    }
    /* 滑到其他項目、新底線畫出時，目前頁的底線照原本的動畫收回 */
    ul:has(a:not(.current):hover) a.current::after {
      width: 0;
    }
  }
  h1,
  header > a {
    font-size: 1rem;
    line-height: 1.3;
    margin: 0;
    padding: 0;
  }
  h1 {
    font-weight: inherit;
  }
  /* 讓 TextSlider 的 inline-block 不拉高行高，兩欄換行後行距一致；導覽也一樣，三組字才會上緣對齊 */
  h1 :global(.oh),
  .header-subtitle :global(.oh),
  ul :global(.oh) {
    vertical-align: top;
  }
  .header-subtitle__line2::before {
    content: " ";
  }
  @media screen and (max-width: 49.99em) {
    header {
      align-items: start;
    }
    .header-subtitle__line2 {
      display: block;
      font-size: 1rem;
      margin: 0;
    }
    .header-subtitle__line2::before {
      content: none;
    }
  }
  ul {
    display: flex;
    /* 導覽是操作，字重 500（全站操作類統一），比左側站名 700 細一級；
       細字看起來比粗字大，字級縮一點點做光學補正 */
    font-weight: 500;
    font-size: 15.5px;
    letter-spacing: 0.05em;
    /* 中文字比英文高，行高 1 時 TextSlider 會切掉字頂；和左側副標同樣用 1.3 */
    line-height: 1.3;
    list-style: none;
    /* 關於我和合作／委託之間略寬一點 */
    gap: 1.10rem;
    margin: 0;
    padding: 0;
    grid-column: auto / span 2;
  }
  /* 手機：導覽和右欄的「Lettering & Logotype」左邊對齊 */
  @media screen and (max-width: 49.99em) {
    ul {
      grid-column: 2;
    }
  }
  @media screen and (min-width: 50em) {
    header {
      grid-template-columns: 20vw 1fr auto auto;
    }
  }
</style>
